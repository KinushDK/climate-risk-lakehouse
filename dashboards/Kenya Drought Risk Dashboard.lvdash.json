{
  "datasets": [
    {
      "name": "2e61b1a5",
      "displayName": "risk_by_month",
      "config": {
        "version": "1.1",
        "source": "SELECT d.county_name, d.district_name, d.lat, d.lon,\r\n       r.as_of_month, r.risk_score, r.risk_tier,\r\n       r.rain_pct_of_normal, r.rain_severity, r.soil_severity, r.heat_severity,\r\n       p.population, p.is_urban, r.soil_imputed\r\nFROM workspace.climate_gold.district_risk_score r\r\nJOIN workspace.climate_silver.districts d USING (district_id)\r\nJOIN workspace.climate_silver.district_population p USING (district_id)\r\nWHERE r.as_of_month >= '2005-01-01'",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "risk_scores",
      "displayName": "District Risk Scores",
      "config": {
        "source": "workspace.climate_gold.district_risk_score",
        "measures": [
          {
            "name": "avg_risk_score",
            "expr": "AVG(risk_score)",
            "displayName": "Avg Risk Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "max_risk_score",
            "expr": "MAX(risk_score)",
            "displayName": "Max Risk Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "avg_rain_z",
            "expr": "AVG(rain_z)",
            "displayName": "Avg Rainfall Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_soil_z",
            "expr": "AVG(soil_z)",
            "displayName": "Avg Soil Moisture Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_heat_z",
            "expr": "AVG(heat_z)",
            "displayName": "Avg Heat Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_rain_pct_normal",
            "expr": "AVG(rain_pct_of_normal)",
            "displayName": "Avg Rainfall % of Normal",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "district_count",
            "expr": "COUNT(DISTINCT district_id)",
            "displayName": "Districts Assessed",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_rain_severity",
            "expr": "AVG(rain_severity)",
            "displayName": "Avg Rainfall Severity",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Monthly composite drought risk score (0-100) and tier per sub-county",
        "dimensions": [
          {
            "name": "district_id",
            "expr": "district_id"
          },
          {
            "name": "as_of_month",
            "expr": "as_of_month",
            "displayName": "Assessment Month",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "risk_tier",
            "expr": "risk_tier",
            "displayName": "Risk Tier"
          }
        ]
      }
    },
    {
      "name": "districts",
      "displayName": "Districts",
      "config": {
        "version": "1.1",
        "source": "workspace.climate_silver.districts",
        "comment": "Kenyan sub-counties with geo coordinates and county mapping",
        "dimensions": [
          {
            "name": "district_id",
            "expr": "district_id",
            "comment": "Unique sub-county identifier"
          },
          {
            "name": "district_name",
            "expr": "district_name",
            "displayName": "District Name"
          },
          {
            "name": "county_name",
            "expr": "county_name",
            "displayName": "County"
          },
          {
            "name": "lat",
            "expr": "lat",
            "displayName": "Latitude"
          },
          {
            "name": "lon",
            "expr": "lon",
            "displayName": "Longitude"
          },
          {
            "name": "area_km2",
            "expr": "area_km2",
            "displayName": "Area (km²)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "district_anomalies",
      "displayName": "District Anomalies",
      "config": {
        "source": "workspace.climate_gold.district_anomalies",
        "measures": [
          {
            "name": "avg_rain_z",
            "expr": "AVG(rain_z)",
            "displayName": "Avg Rainfall Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_soil_z",
            "expr": "AVG(soil_z)",
            "displayName": "Avg Soil Moisture Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_heat_z",
            "expr": "AVG(heat_z)",
            "displayName": "Avg Heat Z-Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_rain_pct_normal",
            "expr": "AVG(rain_pct_of_normal)",
            "displayName": "Avg Rainfall % of Normal",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "3-month rolling conditions compared with each sub-county 1991-2020 normal",
        "dimensions": [
          {
            "name": "district_id",
            "expr": "district_id"
          },
          {
            "name": "month",
            "expr": "month",
            "displayName": "Month",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          }
        ]
      }
    },
    {
      "name": "resource_allocation",
      "displayName": "Resource Allocation",
      "config": {
        "source": "workspace.climate_gold.resource_allocation",
        "measures": [
          {
            "name": "total_allocated_kes",
            "expr": "SUM(allocated_kes)",
            "displayName": "Total Allocated (KES)",
            "format": {
              "type": "currency",
              "currencyCode": "KES",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_population",
            "expr": "SUM(population)",
            "displayName": "Total Population",
            "format": {
              "type": "number",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_kes_per_person",
            "expr": "AVG(kes_per_person)",
            "displayName": "Avg KES per Person",
            "format": {
              "type": "currency",
              "currencyCode": "KES",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_need_weight",
            "expr": "AVG(need_weight)",
            "displayName": "Avg Need Weight",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_share_pct",
            "expr": "AVG(share_pct)",
            "displayName": "Avg Allocation Share",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Drought-relief budget allocation per eligible rural sub-county",
        "dimensions": [
          {
            "name": "as_of_month",
            "expr": "as_of_month",
            "displayName": "Allocation Month",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "county_name",
            "expr": "county_name",
            "displayName": "County"
          },
          {
            "name": "district_name",
            "expr": "district_name",
            "displayName": "District"
          },
          {
            "name": "district_id",
            "expr": "district_id"
          },
          {
            "name": "risk_tier",
            "expr": "risk_tier",
            "displayName": "Risk Tier"
          }
        ]
      }
    },
    {
      "name": "b97ae00c",
      "displayName": "risk_trend",
      "config": {
        "version": "1.1",
        "source": "SELECT as_of_month,\r\n       ROUND(100 * AVG(CASE WHEN risk_tier = 'High' THEN 1 ELSE 0 END), 1)     AS pct_high,\r\n       ROUND(100 * AVG(CASE WHEN risk_tier = 'Elevated' THEN 1 ELSE 0 END), 1) AS pct_elevated\r\nFROM workspace.climate_gold.district_risk_score\r\nWHERE as_of_month >= '2005-01-01'\r\nGROUP BY as_of_month",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "81a6f5d2",
      "displayName": "allocation",
      "config": {
        "version": "1.1",
        "source": "SELECT county_name, district_name, risk_tier, risk_score, population,\r\n       share_pct, allocated_kes, kes_per_person, as_of_month\r\nFROM workspace.climate_gold.resource_allocation",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
